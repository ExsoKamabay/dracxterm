<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/term_bg"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/term_accent"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/provision_subtitle"
        android:textColor="@color/key_fg"
        android:textSize="12sp"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/provision_starting"
        android:textColor="@color/term_fg"
        android:textSize="14sp"
        android:gravity="center"
        android:minLines="2"
        android:layout_marginBottom="18dp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:indeterminate="true"
        android:progressTint="@color/term_accent"
        android:indeterminateTint="@color/term_accent" />

    <Button
        android:id="@+id/retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/retry"
        android:textColor="@color/term_fg"
        android:backgroundTint="@color/key_bg"
        android:visibility="gone"
        android:layout_marginTop="20dp" />
</LinearLayout>
